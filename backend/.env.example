# =============================================================================
# LIFEOS Backend Environment  (copy to .env — everything has a safe default)
# =============================================================================

APP_NAME=LIFEOS
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Comma or JSON list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Vocal-challenge window before the system autonomously escalates (seconds).
CHALLENGE_TIMEOUT_S=10

# Fallback engine latency budget in milliseconds (guaranteed < 10ms).
FALLBACK_BUDGET_MS=10

# ---------------------------------------------------------------------------
# Optional LLM inference layer. When LLM_PROVIDER=off (default) or the API key
# is empty, the deterministic fallback engine is the sole triage authority —
# the demo NEVER blocks on an external model.
# ---------------------------------------------------------------------------
LLM_PROVIDER=off
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=1800

# ---------------------------------------------------------------------------
# Emergency severity thresholds (shared by perception + fallback engine)
# ---------------------------------------------------------------------------
CRASH_G_THRESHOLD=4.0
CRASH_DB_THRESHOLD=88.0
SEVERE_G_THRESHOLD=6.5